{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.nightfall_xbkq.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0C0D0E"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://nightfa-xbkqcxu-preview-4200.runable.site/",
      "applicationId": "nightfa-xbkqcxu",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.nightfall-xbkq.runable",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoadsInWebContent": true },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0C0D0E"
    },
    "name": "Nightfall",
    "slug": "nightfall",
    "version": "1.0.1",
    "scheme": "runable-nightfa-xbkqcxu",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
