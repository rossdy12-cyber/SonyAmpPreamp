  {
    "trigger": {
      "url-filter": "^https?://([^/]+\\.)?(paypal\\.com|paypalobjects\\.com|stripe\\.com|stripe\\.network|klarna\\.com|squareup\\.com|apple-pay-gateway\\.apple\\.com)/",
