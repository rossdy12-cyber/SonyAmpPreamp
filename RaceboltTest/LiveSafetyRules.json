      "url-filter": "(\\?|&|%3f|%26)(wc-ajax|wc_ajax|action|rest_route)(=|%3d)[^&#]*(checkout|place[-_]?order|process[-_]?payment|create[-_]?order|approve[-_]?order|capture[-_]?order|payment[-_]?intent|ppc[-_]|ppcp|stripe|wcpay)",
